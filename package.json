{
  "name": "broke-music-bot",
  "version": "1.0.0",
  "description": "Enterprise-Grade Premium Discord Music Bot",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "kazagumo",
    "lavalink"
  ],
  "author": "hridumoon1",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.0",
    "kazagumo": "^2.0.0",
    "shoukaku": "^4.0.0",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "sqlite": "^5.0.1",
    "node-cache": "^5.1.2",
    "axios": "^1.6.2",
    "chalk": "^5.3.0",
    "moment": "^2.29.4",
    "moment-duration-format": "^2.3.2"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.10.6",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
